{
  "name": "braintree-web",
  "version": "4.0.0-alpha.0",
  "private": true,
  "license": "MIT",
  "description": "A suite of tools for integrating Braintree in the browser",
  "keywords": [
    "braintree",
    "payments"
  ],
  "author": "braintree <code@getbraintree.com>",
  "homepage": "https://github.com/braintree/braintree-web",
  "repository": "github:braintree/braintree-web",
  "main": "./dist/npm/index.js",
  "files": [
    "dist/npm",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": "./dist/npm/index.js",
    "./package.json": "./package.json",
    "./*.js": "./dist/npm/*.js",
    "./*": "./dist/npm/*.js"
  },
  "scripts": {
    "commit": "./scripts/lint-checks.sh && cz",
    "jsdoc": "tsx scripts/build/build-jsdoc.ts",
    "build": "vp run -v cdn:build && vp run -v npm:build",
    "build:dev": "BRAINTREE_JS_ENV=development vp run -v cdn:build",
    "clean": "rm -rf dist",
    "lint": "vp lint --fix",
    "lint:check": "vp lint",
    "lint:ci": "vp check && markdownlint './src/**/**/*.md' --disable=MD024 --disable=MD013 --ignore=./jsdoc --ignore .gitignore && cspell . --report typos --gitignore && npm run typecheck",
    "release": "./scripts/release",
    "safe-publish": "node scripts/safe-publish.mjs",
    "safe-publish:dry": "node scripts/safe-publish.mjs --dry-run",
    "prepare-release": "node scripts/prepare-release.mjs",
    "verify-deploy": "node scripts/verify-deploy.mjs",
    "format": "vp fmt --write .",
    "test": "BRAINTREE_JS_ENV=development vp test run",
    "test:coverage": "BRAINTREE_JS_ENV=development vp test run --coverage",
    "prepare": "husky",
    "storybook": "env BRAINTREE_JS_ENV=development BRAINTREE_JS_ASSET_URL=/local-build npm run build:cdn && scripts/generate-version-list && node .storybook/scripts/copy-local-build.js && storybook dev -p 6006",
    "typecheck": "scripts/generate-version-list && tsc --noEmit -p tsconfig.json && tsc --noEmit -p src/tsconfig.json",
    "codegen": "graphql-codegen --config codegen.ts && vp fmt --write ./generated/",
    "build:cdn": "vp run -v cdn:build",
    "build:npm": "vp run -v npm:build",
    "build:hosted": "vp run -v cdn:build && tsx scripts/build/copy-to-hosted.ts",
    "build:validate": "vp run -v vp:validate",
    "vp:install": "vp install",
    "vp:cache:clean": "vp cache clean",
    "test:build-scripts": "jest --config scripts/build/jest.config.json --no-coverage",
    "typecheck:build-scripts": "tsc --project scripts/build/tsconfig.json --noEmit && tsc --project scripts/build/tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@braintree/asset-loader": "2.1.0",
    "@braintree/browser-detection": "2.1.1",
    "@braintree/event-emitter": "2.0.4",
    "@braintree/extended-promise": "1.0.3",
    "@braintree/iframer": "2.0.3",
    "@braintree/sanitize-url": "7.0.4",
    "@braintree/uuid": "2.0.0",
    "@braintree/wrap-promise": "3.0.4",
    "@paypal/fastlane-sdk-loader": "1.2.1",
    "card-validator": "10.0.4",
    "credit-card-type": "10.3.0",
    "framebus": "6.1.0",
    "inject-stylesheet": "7.0.2",
    "qrcode": "1.5.4",
    "restricted-input": "4.2.0"
  },
  "devDependencies": {
    "@braintree/jsdoc-template": "^4.0.0",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@graphql-codegen/cli": "7.0.0",
    "@graphql-codegen/typescript": "6.0.1",
    "@msw/playwright": "^0.6.7",
    "@playwright/test": "~1.62.0",
    "@storybook/addon-docs": "^9.1.2",
    "@storybook/addon-styling-webpack": "^2.0.0",
    "@storybook/html-vite": "^9.1.2",
    "@swc/jest": "^0.2.39",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/applepayjs": "^14.0.9",
    "@types/html-minifier-terser": "^7.0.2",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.11.0",
    "@vitest/coverage-istanbul": "4.1.10",
    "braces": "^3.0.3",
    "cached-path-relative": "1.1.0",
    "chalk": "^4.1.2",
    "check-ecmascript-version-compatibility": "0.1.1",
    "cheerio": "^1.1.0",
    "commitizen": "^4.3.1",
    "cspell": "^9.7.0",
    "cz-customizable": "^7.5.4",
    "decode-uri-component": "0.2.2",
    "dotenv": "^16.0.3",
    "es6-shim": "^0.35.6",
    "graphql-codegen-typescript-mock-data": "5.1.1",
    "gzip-size": "^6.0.0",
    "html-minifier-terser": "^7.2.0",
    "http-server": "^14.1.1",
    "husky": "^9.1.7",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-instrument": "^6.0.3",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-reports": "^3.1.7",
    "jest": "^29.2.1",
    "jsdoc": "^4.0.0",
    "jsdom": "^26.1.0",
    "json5": "2.2.3",
    "lint-staged": "^15.2.11",
    "lodash": "^4.18.0",
    "loose-envify": "^1.0.0",
    "markdownlint": "^0.40.0",
    "markdownlint-cli": "^0.48.0",
    "minimist": "1.2.8",
    "msw": "^2.14.6",
    "nyc": "^18.0.0",
    "playwright": "~1.62.0",
    "posix-getopt": "^1.2.1",
    "postcss": "^8.5.6",
    "readline-sync": "^1.4.10",
    "requirejs": "^2.3.6",
    "storybook": "^9.1.2",
    "table": "^6.8.0",
    "tailwindcss": "^4.1.12",
    "tmp": "^0.2.1",
    "tsx": "4.23.1",
    "typescript": "^5.8.3",
    "v8-to-istanbul": "^9.3.0",
    "vite-plus": "0.2.4",
    "zod": "4.4.3"
  },
  "overrides": {
    "vite": ">=7.3.5 <8.0.0"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-customizable"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@11.17.0"
}
