{
  "name": "braintree-web",
  "version": "3.143.0",
  "license": "MIT",
  "main": "src/index.js",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/braintree/braintree-web"
  },
  "scripts": {
    "clean:integration": "rm -rf test-results/ && rm -rf log*/ && rm -rf playwright-report/ && rm local.log",
    "jsdoc": "./scripts/npm-to-gulp jsdoc",
    "prebuild": "npm run prettier",
    "build": "./scripts/npm-to-gulp build",
    "build:dev": "BRAINTREE_JS_ENV=development ./scripts/npm-to-gulp build",
    "watch": "gulp watch:integration",
    "prelint": "npm run prettier",
    "lint": "eslint . --cache --fix",
    "lint-no-cache-no-fix": "eslint .",
    "release": "./scripts/release",
    "safe-publish": "node scripts/safe-publish.mjs",
    "safe-publish:dry": "node scripts/safe-publish.mjs --dry-run",
    "prepare-release": "node scripts/prepare-release.mjs",
    "verify-deploy": "node scripts/verify-deploy.mjs",
    "posttest": "npm run lint",
    "prettier": "prettier --write . --cache",
    "test": "BRAINTREE_JS_ENV=development jest --config=jest.config.json",
    "prepare": "husky",
    "storybook:docs": "storybook dev --docs",
    "prestorybook:dev": "scripts/generate-version-list",
    "storybook:dev": "storybook dev -p 6006",
    "storybook:dev-local": "npm run storybook:copy-local-build && storybook dev -p 6006",
    "prestorybook:copy-local-build": "scripts/generate-version-list",
    "storybook:copy-local-build": "node .storybook/scripts/copy-local-build.js",
    "generate-test-certs": ".storybook/scripts/generate-test-certs.sh",
    "storybook:build": "mkdir -p ./.storybook/static && rm -rf ./storybook-static && storybook build",
    "storybook:run-build": "http-server ./storybook-static -S -C .storybook/certs/localhost.crt -K .storybook/certs/localhost.key -p 8080",
    "build:integration": "env BRAINTREE_JS_COVERAGE_BUILD=true npm run build && npm run storybook:copy-local-build && npm run storybook:build",
    "test:integration": "npm run build:integration && env BRAINTREE_JS_ENV=development playwright test --config=.storybook/tests/playwright.config.ts",
    "typecheck": "scripts/generate-version-list && tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@braintree/asset-loader": "2.0.3",
    "@braintree/browser-detection": "2.1.0",
    "@braintree/event-emitter": "0.4.1",
    "@braintree/extended-promise": "1.0.0",
    "@braintree/iframer": "2.0.1",
    "@braintree/sanitize-url": "7.0.4",
    "@braintree/uuid": "2.0.0",
    "@braintree/wrap-promise": "2.1.0",
    "@paypal/fastlane-sdk-loader": "1.2.1",
    "card-validator": "10.0.3",
    "credit-card-type": "10.2.0",
    "framebus": "6.0.3",
    "inject-stylesheet": "7.0.0",
    "promise-polyfill": "8.2.3",
    "restricted-input": "4.0.3"
  },
  "devDependencies": {
    "@ladjs/gulp-envify": "^2.0.1",
    "@playwright/test": "1.60.0",
    "@storybook/addon-docs": "^9.1.2",
    "@storybook/addon-styling-webpack": "^2.0.0",
    "@storybook/html-vite": "^9.1.2",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/applepayjs": "^14.0.9",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.11.0",
    "braces": "^3.0.3",
    "browserify": "^17.0.0",
    "browserify-derequire": "^1.1.1",
    "cached-path-relative": "1.1.0",
    "chalk": "^4.1.2",
    "check-ecmascript-version-compatibility": "0.1.1",
    "cheerio": "^1.1.0",
    "decode-uri-component": "0.2.2",
    "del": "^6.0.0",
    "dotenv": "^16.0.3",
    "envify": "4.1.0",
    "es6-shim": "^0.35.6",
    "eslint": "^9.30.1",
    "eslint-config-braintree": "^7.0.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-jsdoc": "^51.3.1",
    "eslint-plugin-prettier": "^5.5.1",
    "eslint-plugin-storybook": "^9.1.2",
    "gulp": "^4.0.2",
    "gulp-minifier": "^3.5.0",
    "gulp-remove-code": "^3.0.2",
    "gulp-rename": "^2.0.0",
    "gulp-replace": "^1.1.3",
    "gzip-size": "^6.0.0",
    "http-server": "^14.1.1",
    "husky": "^9.1.7",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-instrument": "^6.0.3",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-reports": "^3.1.7",
    "jest": "^29.2.1",
    "jest-environment-jsdom": "^29.7.0",
    "jsdoc": "^4.0.0",
    "jsdoc-template": "braintree/jsdoc-template#3.2.0",
    "json5": "2.2.3",
    "lint-staged": "^15.2.11",
    "lodash": "^4.18.0",
    "loose-envify": "^1.0.0",
    "minimist": "1.2.8",
    "mkdirp": "^1.0.4",
    "mock-xmlhttprequest": "^7.0.4",
    "nyc": "^18.0.0",
    "playwright": "1.60.0",
    "posix-getopt": "^1.2.1",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "readline-sync": "^1.4.10",
    "requirejs": "^2.3.6",
    "storybook": "^9.1.2",
    "table": "^6.8.0",
    "tailwindcss": "^4.1.12",
    "terser": "4.8.1",
    "tmp": "^0.2.1",
    "typescript": "^5.8.3",
    "uglify-js": "^3.19.3",
    "unreachable-branch-transform": "0.5.1",
    "v8-to-istanbul": "^9.3.0",
    "watchify": "^4.0.0"
  },
  "overrides": {
    "vite": ">=7.3.2 <8.0.0",
    "fsevents": "^2.3.2"
  },
  "browserify": {
    "transform": [
      [
        "envify",
        {
          "_": "purge"
        }
      ],
      "unreachable-branch-transform"
    ]
  }
}
